# 复制到 /opt/tgbox/tgbox.env 再填；这个文件不要提交
# 用哪个 AI：claude / codex / antigravity
TGBOX_AGENT=claude
# 你的 Telegram 数字 id。配对前留空：中继版配对时自动填；Claude 配对后从 ~/.claude/channels/telegram/access.json 的 allowFrom 里抄过来
TG_OWNER_ID=
TGBOX_DIR=/opt/tgbox/claude
TGBOX_WORK=/root/tgbot
TGBOX_TZ=Asia/Shanghai
# Codex / Antigravity：1 = 所有命令直接执行不再问；0 = 危险操作在 Telegram 里弹按钮问你
TGBOX_FULL=0
