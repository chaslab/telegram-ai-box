# 复制成 tapdesk.env 再改；这个文件不要提交
TAPDESK_OWNER=<用户的 Telegram 数字 id>
# bot token 二选一：纯 token 文件，或含 TELEGRAM_BOT_TOKEN=... 的 env 文件
TAPDESK_TOKEN_FILE=/path/to/token
#TAPDESK_TOKEN_ENVFILE=/path/to/.env
TAPDESK_DISPLAY=:99                # 要给用户看的 X 桌面
#XAUTHORITY=/home/<user>/.Xauthority
TAPDESK_DESK=                    # 可选：能启动/停止桌面浏览器的脚本（见 desk.sh.example），桌面常开就留空
TAPDESK_OMNIBOX=0                  # Chrome 最大化在 1280x800 左上角时设 1：点地址栏也自动弹键盘
TAPDESK_OMNIBOX_Y=42              # 地址栏上沿：没有顶部任务栏 42；XFCE 顶部任务栏下最大化约 70
TAPDESK_UFW=1                      # 机器上有 ufw 就设 1：开窗时临时放行 443，关窗时撤掉
TAPDESK_DOMAIN=<公网IP用横杠>.sslip.io
#TAPDESK_BIND=0.0.0.0              # 默认绑 eth0 地址；机器上 443 没被别的程序占就可以 0.0.0.0
